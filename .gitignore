# Node.js
# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
server/.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/
pids/
*.pid
*.seed
*.sock

# Build artifacts
# For client (React)
client/build/
client/dist/

# For server (if any build step generates a dist folder)
server/dist/

# Test coverage
coverage/
client/coverage/
server/coverage/

# Editor/IDE specific files
.vscode/        # VS Code
.idea/          # IntelliJ IDEA / WebStorm
*.sublime-project
*.sublime-workspace
*.swp           # Vim swap files
*.swo           # Vim swap files

# Operating System files
.DS_Store       # macOS
Thumbs.db       # Windows

# Misc
*.tgz           # tarballs generated by npm pack
.npm/
.yarn/
.pnp/
.pnp.js

# Next.js specific (if applicable, though not explicitly in tech stack, good to have for JS projects)
.next/

# Vercel deployment files
.vercel/

# Docker
.dockerignore

# CI/CD specific (if any local artifacts are generated)
.github/workflows/*.yml.bak # Example for backup files if any are created locally

# Temporary files
tmp/
temp/