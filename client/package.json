      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
  // Note: For production deployments, ensure the client is served from the same domain as the backend
  // or configure CORS appropriately.
  // This proxy setting is for development only to avoid CORS issues when the React dev server
  // runs on a different port than the Node.js backend.

  // Cross-Project Context:
  // In a microservices architecture, this client might also interact with other services.
  // For example, if there was a shared 'User Profile' service, API calls might look like:
