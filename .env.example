# Recipe Unit Converter Environment Variables

# --- Server Configuration ---
# These variables are used by the Node.js backend (server/).

# Port on which the Node.js server will listen.
PORT=5000

# Node.js environment mode. Use 'development' for local development, 'production' for deployment.
NODE_ENV=development

# Comma-separated list of origins allowed to make requests to the API (CORS).
# In development, this is typically your React app's development server URL.
# In production, this would be your deployed frontend URL.
CORS_ORIGIN=http://localhost:3000

# API version prefix for all routes.
API_PREFIX=/api/v1

# --- Client Configuration ---
# These variables are used by the React frontend (client/).
# For React apps, environment variables must be prefixed with REACT_APP_ to be exposed to the browser.

# Base URL for the backend API. The React app will make requests to this URL.
# In development, this points to your local Node.js server.
# In production, this would be your deployed backend API URL.
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# React app environment mode.
REACT_APP_NODE_ENV=development

# --- Cross-Project / Microservice Context ---
# These variables are examples of how this service might interact with or reference other services
# within a larger ecosystem. While not directly used by the Recipe Unit Converter's core logic,
# they illustrate potential integration points or service discovery.

# URL for the Interactive To-Do List service API.
TODO_LIST_API_URL=http://localhost:5001/api/v1/todos
REACT_APP_TODO_LIST_URL=http://localhost:3001

# URL for the Personal Blog Platform service API.
BLOG_API_URL=http://localhost:5002/api/v1/posts
REACT_APP_BLOG_URL=http://localhost:3002

# API Key for an external weather service (if the Weather Dashboard used one).
# This is an example to show how API keys for other services might be stored.
WEATHER_API_KEY=your_weather_api_key_here
REACT_APP_WEATHER_DASHBOARD_URL=http://localhost:3003

# URL for the Custom URL Shortener service API.
URL_SHORTENER_SERVICE_URL=http://localhost:5004/api/v1/shorten
REACT_APP_URL_SHORTENER_URL=http://localhost:3004

# URL for the Interactive E-commerce Product Catalog service API.
ECOMMERCE_SERVICE_URL=http://localhost:5005/api/v1/products
REACT_APP_ECOMMERCE_CATALOG_URL=http://localhost:3005

# URL for the AI-Powered Content Assistant service API.
AI_ASSISTANT_SERVICE_URL=http://localhost:5006/api/v1/generate
REACT_APP_AI_ASSISTANT_URL=http://localhost:3006

# --- Instructions ---
# 1. Copy this file to `.env` in the project root.
# 2. Copy relevant sections to `server/.env` and `client/.env` respectively.
#    - For `server/.env`, copy all variables *not* prefixed with `REACT_APP_`.
#    - For `client/.env`, copy all variables prefixed with `REACT_APP_`.
# 3. Replace placeholder values (e.g., `your_weather_api_key_here`) with actual values if needed.
# 4. Do NOT commit your `.env` file to version control. Use `.gitignore` to prevent this.